# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=architecture_backend.settings.dev
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database / cache (localhost values for running Django outside Docker;
# docker-compose overrides these with service hostnames)
DATABASE_URL=postgres://architecthire:architecthire@localhost:5433/architecthire
REDIS_URL=redis://localhost:6380

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Instant frontend cache purge on admin saves (blank = disabled, 60s ISR still applies).
# Use localhost, not host.docker.internal, unless Django itself runs in a container.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
# Writes accumulate for this long so a bulk publish sends one purge, not hundreds.
REVALIDATE_DEBOUNCE_SECONDS=0.5

# Scheduled jobs. There is no Celery beat process: Vercel Cron calls the frontend, which
# forwards to /api/v1/internal/cron/<job>/ with this secret. Must match the CRON_SECRET
# set on the Vercel project. Blank = endpoint disabled (503), nothing is ever swept.
CRON_SECRET=

# Email (prod: smtp settings)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ArchitectHire <no-reply@architecthire.com>

# DigitalOcean Spaces (S3-compatible).
#
# REQUIRED in production — prod settings refuse to start without the first four. There
# used to be a FileSystemStorage fallback, but on App Platform that served 404 for every
# uploaded image while reporting a successful save in the admin, so it is gone.
#
# Leave them blank locally: dev writes to ./media and serves it from Django.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
# The bucket's own region. The default (sfo3) matches the bucket we use; a wrong value
# makes SigV4 sign uploads for the wrong region and Spaces rejects every PUT with
# SignatureDoesNotMatch, while reads keep working — so it looks like "saving an image in
# admin silently does nothing".
AWS_S3_REGION_NAME=sfo3
# Optional: serve media from the Spaces CDN edge instead of the bucket origin. Set this
# to <bucket>.<region>.cdn.digitaloceanspaces.com once the CDN is enabled on the Space.
# NOTE: whatever host ends up in the media URLs must also be listed in BOTH frontends'
# `images.remotePatterns` (next.config.ts), or Next rejects it with
# 400 INVALID_IMAGE_OPTIMIZE_REQUEST and no image renders at all.
AWS_S3_CUSTOM_DOMAIN=
# virtual = https://<bucket>.<region>.digitaloceanspaces.com/... (what the frontends allow)
# path    = https://<region>.digitaloceanspaces.com/<bucket>/... (botocore's default
#           against a custom endpoint, and the reason every image 400'd in production)
AWS_S3_ADDRESSING_STYLE=virtual

# Stripe (real values live in git-ignored .env only — never commit keys here)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Clerk (auth provider — hosts email + Google sign-in; backend verifies session JWTs)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SIGNING_SECRET=

# Web Push (generate with: uv run python -c "from apps.notifications.vapid import generate; generate()")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=grantxdev@gmail.com

# Observability
SENTRY_DSN=
