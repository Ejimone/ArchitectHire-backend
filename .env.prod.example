# Production environment for the Oracle VM. Copy to .env.prod on the machine (git-ignored)
# and fill every value. Nothing here has a safe default. Compose reads it for the Django
# services; POSTGRES_*, API_HOST, WEB_CONCURRENCY and MEDIA_DIR are read by compose itself.

# --- Identity ------------------------------------------------------------------------
SECRET_KEY=
API_HOST=api.architecthire.com
ALLOWED_HOSTS=api.architecthire.com,web,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.architecthire.com
FRONTEND_URL=https://architecthire.com
CORS_ALLOWED_ORIGINS=https://architecthire.com,https://www.architecthire.com,https://architecthire-studio.vercel.app,https://studio.architecthire.com
WS_ALLOWED_ORIGINS=https://architecthire.com,https://www.architecthire.com,https://architecthire-studio.vercel.app,https://studio.architecthire.com

# --- Data ---------------------------------------------------------------------------
POSTGRES_USER=architecthire
POSTGRES_PASSWORD=
POSTGRES_DB=architecthire
DB_POOL_MIN=1
DB_POOL_MAX=4
WEB_CONCURRENCY=4

# --- Media (VM disk; Caddy serves MEDIA_DIR at https://$API_HOST/media/) ---------------
MEDIA_DIR=/srv/architecthire/media
PRIVATE_MEDIA_DIR=/srv/architecthire/media-private
STUDIO_MAX_UPLOAD_BYTES=31457280

# --- Frontend cache purge (must match REVALIDATE_SECRET / CRON_SECRET on Vercel) --------
FRONTEND_REVALIDATE_URL=https://architecthire.com/api/revalidate
REVALIDATE_SECRET=
CRON_SECRET=

# --- Auth (Clerk) — same instance as the site ------------------------------------------
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Payments (Stripe) -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Web push --------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=

# --- Email -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Optional --------------------------------------------------------------------------
SENTRY_DSN=
NOTIFY_VIA_CELERY=false
